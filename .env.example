# FinMind API token（股權分散表／大戶籌碼必備，且需 Backer 以上會員）
# 註冊取得：https://finmindtrade.com/
FINMIND_TOKEN=

# Email 通知（Gmail SMTP／單人自用）
# 需先開啟 Google 兩步驟驗證，再產生「應用程式密碼」：
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# 收件信箱（可省略；優先使用「通知」選單內的設定，再才用此值，最後才用 GMAIL_USER）
NOTIFY_TO=
# （選用／已不需要）定時與立即掃描目前皆不需密鑰；留空即可
NOTIFY_CRON_SECRET=
# 設為 false 可關閉寄信（掃描仍可跑）
NOTIFY_ENABLED=true

# （選用）FRED API key：有的話 HY 利差改走官方 API，沒有則用公開備援
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

