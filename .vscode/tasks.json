{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 啟動開發伺服器",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev.sh",
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
